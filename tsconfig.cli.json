{
  // Bun side: the `share` CLI's R2 client (Bun S3 + passage). Separate from the
  // Worker tsconfig because Bun's globals and the Workers runtime types collide.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun"]
  },
  "include": ["r2-client.ts", "lib/cdn.ts"]
}

{
  // Worker side: the whole app lives under src/ (Hono Worker + storage + pure lib
  // + tests). Types come from wrangler types (worker-configuration.d.ts) — NOT
  // @types/bun. The Bun `share` CLI (bin/share) is `@ts-nocheck` and fully
  // self-contained — it imports nothing from cdn — so it needs no tsconfig.
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    // Server pages (src/*.tsx) render with hono/jsx — esbuild (wrangler + vitest)
    // reads these same fields, so there's no separate JSX build config anywhere.
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "noEmit": true,
    "allowJs": false,
    "types": ["./worker-configuration.d.ts", "@cloudflare/vitest-pool-workers/types"],
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "worker-configuration.d.ts", "vitest.config.ts"],
  "exclude": ["node_modules"]
}

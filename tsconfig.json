{
  // Worker side: Hono Worker + storage + pure lib + tests. Types come from
  // wrangler types (worker-configuration.d.ts) — NOT @types/bun. The Bun `share`
  // CLI (bin/share) is `@ts-nocheck` and shares only the pure lib/cdn.ts, so it
  // needs no tsconfig of its own.
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "allowJs": false,
    "types": ["./worker-configuration.d.ts", "@cloudflare/vitest-pool-workers/types"],
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "worker.ts",
    "storage.ts",
    "*.test.ts",
    "lib/**/*.ts",
    "worker-configuration.d.ts",
    "test-env.d.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules"]
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cdn-explorer",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-02",
  "observability": { "enabled": true },

  // R2 binding → env.BUCKET (the same bucket the `share` CLI writes to).
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "cdn" }],

  // Static UI lives in public/. run_worker_first=true means the Worker runs for
  // EVERY request, so the password gate covers the assets too; the Worker reads
  // index.html/styles.css/app.js via env.ASSETS and serves them as one inlined doc.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // The Worker owns cdn.ramonfabrega.com: / = explorer, /<key> = object downloads
  // (replaces R2's custom-domain serving). wrangler provisions the DNS + cert.
  "routes": [{ "pattern": "cdn.ramonfabrega.com", "custom_domain": true }],

  // Branch previews (Workers Builds runs `versions upload` off master) get a URL at
  // <branch>-cdn-explorer.<subdomain>.workers.dev. Off by default since wrangler 4.34,
  // and doubly so here: taking the custom domain dropped the workers.dev route, which
  // is what preview URLs hang off. A preview shares this config's bindings — same live
  // R2 bucket, same secrets — but never owns the custom domain or runs the cron.
  "preview_urls": true,

  // Font bytes for the og:image cards (src/card.ts) — bundled as raw ArrayBuffers.
  // takumi's WASM module needs no rule: wrangler resolves the package's `workerd`
  // export condition and compiles the .wasm import natively.
  "rules": [{ "type": "Data", "globs": ["**/*.woff2"], "fallthrough": true }],

  // Daily expiry sweep (src/storage.ts `sweep`): deletes objects >30d old unless
  // flagged `permanent`. Replaces the bucket's blanket R2 lifecycle rule, which
  // couldn't exempt individual objects (only the multipart-abort rule remains on
  // the bucket itself).
  "triggers": { "crons": ["17 6 * * *"] }

  // Secrets (set with `wrangler secret put`, or .dev.vars locally):
  //   CDN_PASSWORD, CDN_SESSION_SECRET, CDN_UPLOAD_TOKEN
}

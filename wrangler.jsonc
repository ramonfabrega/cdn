{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cdn-explorer",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-02",
  "observability": { "enabled": true },

  // R2 binding → env.BUCKET. `bucket_name` is a DEFAULT, not a reference: the
  // Deploy to Cloudflare button reads this file, provisions a bucket with this
  // name on the presser's account and binds it. Rename it here before deploying
  // if you want a different one; `wrangler deploy` provisions it either way.
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "cdn" }],

  // Static UI lives in public/. run_worker_first=true means the Worker runs for
  // EVERY request, so the password gate covers the assets too; the Worker reads
  // index.html/styles.css/app.js via env.ASSETS and serves them as one inlined doc.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // No `routes` here: this repo is a template, and the zone belongs to whoever
  // presses the button — the deploy can't provision a domain it doesn't own. A
  // fresh deploy answers on <name>.<subdomain>.workers.dev and is fully working
  // there. To put the Worker on your own domain, add ONE line and redeploy;
  // wrangler provisions the DNS record and the certificate:
  //
  //   "routes": [{ "pattern": "cdn.example.com", "custom_domain": true }],
  //
  // Nothing else changes — every page brands itself from the request host
  // (src/lib/ui.ts `brand`), so the explorer, the folder pages and the unfurl
  // cards all start saying your domain the moment it resolves.

  // Branch previews (Workers Builds runs `versions upload` off non-production
  // branches) get a URL at <branch>-<name>.<subdomain>.workers.dev. Off by
  // default since wrangler 4.34. A preview shares this config's bindings — same
  // R2 bucket, same secrets — but never owns a custom domain or runs the cron.
  // Note that taking a custom domain drops the workers.dev route that preview
  // URLs hang off; re-enable it with "workers_dev": true if you want both.
  "preview_urls": true,

  // Font bytes for the og:image cards (src/card.ts) — bundled as raw ArrayBuffers.
  // takumi's WASM module needs no rule: wrangler resolves the package's `workerd`
  // export condition and compiles the .wasm import natively.
  "rules": [{ "type": "Data", "globs": ["**/*.woff2"], "fallthrough": true }],

  // Daily expiry sweep (src/storage.ts `sweep`): deletes objects >30d old unless
  // flagged `permanent`. Replaces the bucket's blanket R2 lifecycle rule, which
  // couldn't exempt individual objects (only the multipart-abort rule remains on
  // the bucket itself).
  "triggers": { "crons": ["17 6 * * *"] }

  // ── secrets ────────────────────────────────────────────────────────────────
  // Four, all named in .dev.vars.example (which is what the Deploy to Cloudflare
  // button prompts from, and what you copy to .dev.vars for local dev):
  //
  //   CDN_PASSWORD         the explorer's login
  //   CDN_SESSION_SECRET   signs the session cookie
  //   CDN_UPLOAD_TOKEN     bearer for POST /api/upload (the CLI, hooks, Shortcut)
  //   CDN_PURGE_TOKEN      OPTIONAL — a Cloudflare API token scoped to
  //                        Zone → Cache Purge on your zone and nothing else
  //
  // Set them after the first deploy with `wrangler secret put <NAME>`. Auth fails
  // CLOSED: an unset CDN_PASSWORD rejects every login, an unset CDN_UPLOAD_TOKEN
  // rejects every bearer. There are no defaults.
  //
  // ── optional vars: zone-wide cache purge ───────────────────────────────────
  // A write purges the edge. The Cache API only clears the POP the Worker ran
  // in, so with these two set the Worker also calls Cloudflare's zone purge API
  // and invalidates EVERY POP — which is what makes "an overwrite is visible
  // immediately" true for a feed read from anywhere, not just from the machine
  // that published it. Absent (the template default) ⇒ local-POP purge only,
  // never an error. Neither value is a credential: the zone id is in every
  // dashboard URL and the public origin is the whole point of the CDN. The
  // token that goes with them (CDN_PURGE_TOKEN) is the secret. Add once you
  // have a custom domain:
  //
  //   "vars": {
  //     "CDN_ZONE_ID": "<your zone id>",
  //     "CDN_PUBLIC_ORIGIN": "https://cdn.example.com"
  //   },
  //
  // A write always purges CDN_PUBLIC_ORIGIN, never the request's: previews share
  // these bindings, so a preview upload mutates the live bucket and must
  // invalidate the live domain.
}
